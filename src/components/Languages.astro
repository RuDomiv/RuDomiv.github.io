---
import Section from './Section.astro';
import { CONTENT, type Locale } from '../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang].languages;
---

<Section id="idiomas" eyebrow={t.eyebrow} title={t.title} lead={t.lead} class="bg-surface">
  <ol class="border-t border-line" data-stagger>
    {
      t.items.map((item) => (
        <li class="border-b border-line py-7 sm:py-8">
          <div class="flex items-baseline justify-between gap-x-6">
            <h3 class="text-[clamp(1.5rem,3vw,2.25rem)]">{item.name}</h3>
            <p class="tnum shrink-0 text-[clamp(1.25rem,2.2vw,1.625rem)] whitespace-nowrap text-ink-2">
              {item.level}
            </p>
          </div>
          <p class="mt-1.5 text-[0.9375rem] text-ink-3">{item.note}</p>
        </li>
      ))
    }
  </ol>
</Section>
