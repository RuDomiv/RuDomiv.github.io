---
import Section from './Section.astro';
import { CONTENT, type Locale } from '../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang].education;
---

<Section id="formacion" eyebrow={t.eyebrow} title={t.title}>
  <ol class="border-t border-line" data-stagger>
    {
      t.items.map((item) => (
        <li class="border-b border-line py-8">
          <div class="grid gap-x-10 gap-y-2 lg:grid-cols-[13rem_minmax(0,1fr)]">
            <time class="block text-[0.9375rem] text-ink-3 lg:pt-1">{item.period}</time>

            <div>
              <h3 class="text-[1.25rem] font-semibold tracking-[-0.02em] sm:text-[1.5rem]">
                {item.title}
              </h3>
              <p class="mt-2 text-[1.0625rem] text-ink-2">{item.org}</p>
              {item.detail && <p class="mt-1.5 text-[0.9375rem] text-ink-3">{item.detail}</p>}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
