---
import { CONTENT, PHOTO, PHOTO_FALLBACK, type Locale } from '../i18n/content';
import { withBase } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang].hero;
---

<section class="relative flex min-h-[100svh] flex-col justify-center pt-32 pb-24 sm:pt-36">
  <div class="container-page">
    <p class="eyebrow" data-hero>{t.eyebrow}</p>

    <h1 class="mt-5 text-[clamp(2.75rem,8vw,7rem)]" data-hero>
      {t.name}
    </h1>

    <div
      class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-20"
    >
      <div>
        <p
          class="max-w-2xl text-[clamp(1.125rem,2vw,1.5rem)] leading-[1.55] text-ink-2"
          data-hero
        >
          {t.lead}
        </p>

        <dl class="mt-12 border-t border-line-soft" data-hero>
          {
            t.facts.map((fact) => (
              <div class="grid grid-cols-1 gap-1 border-b border-line-soft py-4 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
                <dt class="text-[0.9375rem] text-ink-3">{fact.k}</dt>
                <dd class="text-[0.9375rem] text-ink sm:text-base">{fact.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <figure
        class="order-first aspect-4/5 w-44 overflow-hidden rounded-3xl bg-surface sm:w-56 lg:order-none lg:w-full"
        data-hero
      >
        <img
          id="portrait"
          src={withBase(PHOTO)}
          data-fallback={withBase(PHOTO_FALLBACK)}
          alt={t.photoAlt}
          width="480"
          height="600"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </figure>
    </div>
  </div>

  <a
    href="#enseeiht"
    class="no-print absolute inset-x-0 bottom-9 mx-auto flex w-fit flex-col items-center gap-2 text-[0.8125rem] text-ink-3 transition-colors duration-300 hover:text-ink"
  >
    <span>{t.scrollCue}</span>
    <svg
      class="cue-pulse"
      width="13"
      height="17"
      viewBox="0 0 14 18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      aria-hidden="true"
    >
      <path d="M7 1v14M2 10.5 7 15.5 12 10.5"></path>
    </svg>
  </a>
</section>

<script is:inline>
  // Si aun no se ha subido la foto real, se muestra el marcador de posicion.
  (function () {
    var img = document.getElementById('portrait');
    if (!img) return;
    img.addEventListener(
      'error',
      function () {
        var fb = img.getAttribute('data-fallback');
        if (fb && img.getAttribute('src') !== fb) img.setAttribute('src', fb);
      },
      { once: true }
    );
  })();
</script>
