---
import { CONTENT, CV_FILES, LOCALES, type Locale } from '../i18n/content';
import { cvIsAvailable, localePath, withBase } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang];
const cvHref = withBase(CV_FILES[lang]);
const hasCV = cvIsAvailable(CV_FILES[lang]);
---

<!--
  La barra pasa de 5rem a 3.25rem en cuanto la pagina deja el origen, y solo
  entonces aparece el desenfoque de fondo. Sobre el hero permanece limpia.
-->
<header
  id="site-nav"
  data-stuck="false"
  class="no-print fixed inset-x-0 top-0 z-50 h-20 border-b border-transparent transition-[height,background-color,backdrop-filter,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] data-[stuck=true]:h-13 data-[stuck=true]:border-line/70 data-[stuck=true]:bg-white/72 data-[stuck=true]:backdrop-blur-2xl data-[stuck=true]:backdrop-saturate-180"
>
  <nav class="container-page flex h-full items-center justify-between gap-4" aria-label={t.nav.menu}>
    <a
      href={localePath(lang)}
      class="text-[0.9375rem] font-medium tracking-[-0.02em] whitespace-nowrap transition-opacity duration-300 ease-[cubic-bezier(0.25,0.46,0.45,0.94)] hover:opacity-60"
    >
      Ruslán Domínguez
    </a>

    <div class="flex items-center gap-2.5 sm:gap-4">
      <div
        class="flex items-center rounded-full bg-surface p-0.5"
        role="group"
        aria-label={t.nav.langLabel}
      >
        {
          LOCALES.map((code) => (
            <a
              href={localePath(code)}
              hreflang={code}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 text-xs font-medium uppercase transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] sm:px-3',
                code === lang ? 'bg-white text-ink shadow-sm' : 'text-ink-3 hover:text-ink',
              ]}
            >
              {code}
            </a>
          ))
        }
      </div>

      {
        /* En pantallas estrechas el rotulo se reduce, para que la barra quepa
           en una sola linea junto al nombre y al selector de idioma. */
        hasCV && (
          <a
            href={cvHref}
            download
            class="btn btn-primary px-4 py-1.5 text-[0.8125rem] whitespace-nowrap sm:px-5 sm:py-2 sm:text-sm"
          >
            <span class="hidden sm:inline">{t.nav.download}</span>
            <span class="sm:hidden">CV</span>
          </a>
        )
      }
    </div>
  </nav>
</header>
