---
import Section from './Section.astro';
import { CONTENT, type Locale } from '../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang].about;
---

<Section id="sobre-mi" eyebrow={t.eyebrow} title={t.title}>
  <!-- Breve a proposito: foco tecnico, herramientas y objetivo. La evidencia
       de todo lo demas esta en las secciones que siguen. -->
  <p
    class="max-w-4xl text-[clamp(1.375rem,3vw,2.25rem)] leading-[1.4] tracking-[-0.025em]"
    data-reveal
  >
    {t.text}
  </p>
</Section>
