---
import '@fontsource-variable/inter';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import { CONTENT, EMAIL, LOCALES, type Locale } from '../i18n/content';
import { HREFLANG, localePath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = CONTENT[lang];

const canonical = new URL(localePath(lang), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ruslán Domínguez Ivanova',
  jobTitle: 'Electronic Engineering student',
  description: t.meta.description,
  email: `mailto:${EMAIL}`,
  url: canonical,
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Pontificia Universidad Javeriana' },
    { '@type': 'CollegeOrUniversity', name: 'INP-ENSEEIHT' },
  ],
  knowsLanguage: [
    { '@type': 'Language', name: 'Spanish', alternateName: 'es' },
    { '@type': 'Language', name: 'English', alternateName: 'en' },
    { '@type': 'Language', name: 'French', alternateName: 'fr' },
    { '@type': 'Language', name: 'Russian', alternateName: 'ru' },
  ],
  knowsAbout: [
    'Analog electronics',
    'Microelectronics',
    'Telecommunications',
    'Embedded systems',
    'Systems integration',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />

    {
      LOCALES.map((code) => (
        <link
          rel="alternate"
          hreflang={HREFLANG[code]}
          href={new URL(localePath(code), Astro.site).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('es'), Astro.site).href} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Ruslán Domínguez Ivanova" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={lang} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="data:," />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline>
      // Marca la disponibilidad de JS antes del primer pintado, para que los
      // estados iniciales de animacion solo se apliquen si van a resolverse.
      document.documentElement.classList.add('js');

      // Red de seguridad: si el modulo de movimiento no llega a ejecutarse, el
      // contenido se muestra igualmente. El propio modulo cancela este temporizador.
      window.__motionFailsafe = setTimeout(function () {
        document.documentElement.classList.add('motion-failed');
      }, 2500);
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sm focus:text-white"
    >
      {t.nav.skipToContent}
    </a>

    <Nav lang={lang} />

    <main id="main">
      <slot />
    </main>

    <footer class="bg-black pb-14 text-white">
      <div class="container-page">
        <div
          class="flex flex-wrap items-center justify-between gap-4 border-t border-white/12 pt-8 text-[0.8125rem] text-white/40"
        >
          <p>Ruslán Domínguez Ivanova, Bogotá, Colombia</p>
          <p>{t.footer.updated}</p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
